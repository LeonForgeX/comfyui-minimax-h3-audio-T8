    },
    "MiniMaxChunkFeedForward": {
      "output": [
        "MODEL"
      ],
      "input": {
        "required": {
          "model": [
            "MODEL",
            {}
          ],
          "chunks": [
            "INT",
            {
              "tooltip": "Number of chunks to split the feedforward tokens into. More chunks = lower peak VRAM, slightly more overhead.",
              "default": 2,
              "min": 1,
              "max": 64,
              "step": 1
            }
          ],
          "seq_threshold": [
            "INT",
            {
              "tooltip": "Only chunk when the packed token count exceeds this (skips tiny sequences).",
              "default": 4096,
              "min": 256,
              "max": 262144,
              "step": 256
            }
          ]
        }
      },
      "input_order": {
        "required": [
          "model",
          "chunks",
          "seq_threshold"
        ]
      },
      "python_module": "custom_nodes.ComfyUI-KJNodes",
      "output_name": [
        "model"
      ],
      "display_name": "MiniMax H3 Chunk FeedForward",
      "output_node": false
    },
