{
  "scope": "2026-09-06 isolated server schema; model filename option lists reduced to selected probe values",
  "object_info": {
    "UNETLoader": {
      "output": [
        "MODEL"
      ],
      "input": {
        "required": {
          "unet_name": [
            [
              "minimax_h3_fl2va_pruned_int8_convrot.safetensors"
            ]
          ],
          "weight_dtype": [
            [
              "default",
              "fp8_e4m3fn",
              "fp8_e4m3fn_fast",
              "fp8_e5m2"
            ],
            {
              "advanced": true
            }
          ]
        }
      },
      "input_order": {
        "required": [
          "unet_name",
          "weight_dtype"
        ]
      },
      "python_module": "nodes",
      "output_name": [
        "MODEL"
      ],
      "display_name": "Load Diffusion Model",
      "output_node": false
    },
    "MiniMaxH3VideoOutpaintSampleT8": {
      "output": [
        "T8_H3_OUTPAINT_SAMPLED",
        "STRING"
      ],
      "input": {
        "required": {
          "model": [
            "MODEL",
            {}
          ],
          "prepared": [
            "T8_H3_OUTPAINT_PREPARED",
            {}
          ],
          "seed": [
            "INT",
            {
              "default": 20260808,
              "min": 0,
              "max": {
                "IsPowerOfTwo": false,
                "IsZero": false,
                "IsOne": false,
                "IsEven": false,
                "Sign": 1
              },
              "control_after_generate": true
            }
          ],
          "steps": [
            "INT",
            {
              "default": 20,
              "min": 1,
              "max": 100
            }
          ],
          "resume": [
            "BOOLEAN",
            {
              "default": false
            }
          ]
        },
        "optional": {
          "noise_algorithm": [
            "COMBO",
            {
              "default": "t8.outpaint.coordinate_noise/v1",
              "multiselect": false,
              "options": [
                "t8.outpaint.coordinate_noise/v1",
                "t8.outpaint.native_cpu_noise/v1"
              ]
            }
          ]
        }
      },
      "input_order": {
        "required": [
          "model",
          "prepared",
          "seed",
          "steps",
          "resume"
        ],
        "optional": [
          "noise_algorithm"
        ]
      },
      "python_module": "custom_nodes.outpaint_probe_extension",
      "output_name": [
        "sampled",
        "sampling_report"
      ],
      "display_name": "H3 Video Outpaint · Serial Sample (EXP)",
      "output_node": false
    },
    "MiniMaxLowVRAMAttention": {
      "output": [
        "MODEL"
      ],
      "input": {
        "required": {
          "model": [
            "MODEL",
            {}
          ],
          "head_chunks": [
            "INT",
            {
              "tooltip": "Number of head groups to split the attention call into. Kernel-internal transients scale down with this; heads are independent so the result is unchanged.",
              "default": 4,
              "min": 1,
              "max": 56,
              "step": 1
            }
          ]
        }
      },
      "input_order": {
        "required": [
          "model",
          "head_chunks"
        ]
      },
      "python_module": "custom_nodes.ComfyUI-KJNodes",
      "output_name": [
        "model"
      ],
      "display_name": "MiniMax H3 Low VRAM Attention",
      "output_node": false
    },
    "MiniMaxH3VideoOutpaintPlanT8": {
