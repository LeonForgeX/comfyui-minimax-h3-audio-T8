        "T8_H3_OUTPAINT_PLAN",
        "STRING"
      ],
      "input": {
        "required": {
          "source_video": [
            "VIDEO",
            {}
          ],
          "aspect": [
            "COMBO",
            {
              "default": "9:16",
              "multiselect": false,
              "options": [
                "source",
                "9:16",
                "16:9",
                "1:1",
                "4:3",
                "3:4",
                "9:12",
                "custom"
              ]
            }
          ],
          "left": [
            "INT",
            {
              "default": 0,
              "min": 0,
              "max": 32768
            }
          ],
          "top": [
            "INT",
            {
              "default": 0,
              "min": 0,
              "max": 32768
            }
          ],
          "right": [
            "INT",
            {
              "default": 0,
              "min": 0,
              "max": 32768
            }
          ],
          "bottom": [
            "INT",
            {
              "default": 0,
              "min": 0,
              "max": 32768
            }
          ],
          "anchor_x": [
            "FLOAT",
            {
              "default": 0.5,
              "min": 0,
              "max": 1
            }
          ],
          "anchor_y": [
            "FLOAT",
            {
              "default": 0.5,
              "min": 0,
              "max": 1
            }
          ],
          "generation_megapixels": [
            "FLOAT",
            {
              "default": 0.5,
              "min": 0.01,
              "max": 64
            }
          ],
          "window_frames": [
            "COMBO",
            {
              "default": "73",
